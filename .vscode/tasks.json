
{
    "version": "2.0.0",
    "tasks": [
			{
				"label": "Build Campus Connect",
				"type": "shell",
				"command": "C:/MinGW/bin/g++.exe",
				"args": [
					"-std=c++17",
					"-Wall",
					"-Wextra",
					"-g",
					"-I",
					"${workspaceFolder}/include",
					"${workspaceFolder}/src/main.cpp",
					"-o",
					"${workspaceFolder}/CampusConnect.exe"
				],
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"problemMatcher": [
					"$gcc"
				]
			}
		]
}